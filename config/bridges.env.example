# ============================================
# Common variables
# ============================================

# --------------------------------------------
# Backup Directory
#
# Allow user to define a custom directory
# for backup NetworkManager and firewalld 
# profile's
#
# default value : /var/lib/pfVEdge

BACKUP_DIR="/var/lib/pfVEdge"

# --------------------------------------------
# Logging
#
# Available:
# INFO (default)
# DEBUG
#

LOG_LEVEL=INFO

# ============================================
# bridges-host configuration
#
# Core configuration (REQUIRED)
#
#
# Declarative network definition
#
# Format:
# bridge_name:type:interfaces[,interfaces]:ipv4:vlans[,vlans]:firewall-role
#
# each bridge is defined per line
# multiple bridge = multiple lines 
#
# * bridge_name (mandatory)
# user defined
#
# * type (mandatory)
# can be 'podman' or anyhting else can be considered as 'eth'
# At this time, jsut used to know if it is a podman network and 
# create it at first launch.
#
# * interfaces (mandatory)
# interface or comma's separated list of interfaces to 
# associate with bridge
#
# * ipv4 (optionnal)
# user defined ipv4 address configured for bridge.
# can be :
# - cidr address : 1.2.3.4/24
# - dhcp for automatic addressing
# - empty field for no adresses
# 
# * vlans (optionnal)
# At this time, passive declaration
# must be a numeric value or a comma's separated list 
# of numeric value.
#
# * firewall-role (mandatory)
# used to define zone name for firewalld
# must be wan|lan|or any string value
#
# Examples:
#
# Bridge without interface (DMZ / internal networks)
# dmz:::::dmz
#
# Bridge with podman network (dmz)
# A podman network is created with the "macvlan" driver, parented
# directly on the bridge itself (not on a separate podman-owned
# device) so that containers land on the exact same L2 segment as
# pfSense's TAP for that bridge — no extra wiring needed.
# The "interfaces" field is not used for podman-type entries and can
# be left empty.
# The IPv4 address is the GATEWAY of that segment — it must be
# configured on pfSense's own interface (inside the VM), NOT on the
# host: with macvlan there is no host-side interface holding that IP.
# dmz:podman::1.2.3.4/24::
#
# Bridge with single interface (trunk)
# trunk::eth1:::lan
#
# Bridge with multiple interfaces
# multi::eth1,eth2:::wan
#
# Bridge with VLAN declaration (passive)
# trunk::eth1::10,20,30:
#
# Full example
# core::eth1,eth2:10.0.0.1/24:10,20,30:lan
#
# Lines starting with '#' are ignored
# Empty lines may cause error

BRIDGES_NETWORKS="
# WAN bridge (no host IP, passthrough to pfSense)
wan:eth0::

# TRUNK bridge (LAN + VLANs handled by pfSense)
trunk:eth1::10,20,30,40

# Internal DMZ network (host-managed)
dmz::1.2.3.4/24:
"

# --------------------------------------------
# NetworkManager behavior
# --------------------------------------------

# Allow automatic migration of existing NetworkManager profiles
#
# false (default):
#   - fail if interface already managed
#
# true:
#   - remove existing profile
#   - reattach interface to bridge
#
# WARNING: enabling this may disrupt connectivity
#          in case of misconfig.
#

NM_AUTO_MIGRATE_IFACE=false

# Allow erasing factory config (user) and replacing
# by backup of actual configuration
#
# false (default):
#   - do nothing
#
# true:
#   - remove actual factory backup
#   - save a new factory backup
#

NM_FORCE_FACTORY_BACKUP=false

# --------------------------------------------
# Firewalld behavior
# --------------------------------------------

# In pfSense mode, ssh hes not added on the host's
# firewalld zone
#
# false (default):
#   - ssh will not be added on zone's host
#
# true:
#   - ssh port and service will be added on each bridge
#
# Can be used for direct ssh access on host without pfSense
#

FWD_ALLOW_SSH_HOST=false

# --------------------------------------------
# Tap Behavior
# --------------------------------------------

# by default, tap name will be prefixed with 'tap'
# you can change this mecanism by definig another prefix
# value
# 
# example : tap-wan
#

TAP_PREFIX="tap"

# ============================================
# Notes
# ============================================

# - VLANs are:
#   ✔ validated
#   ✔ stored
#   ❌ NOT created (handled by pfSense or runtime)
#
# - Interfaces:
#   ✔ support multiple values (eth1,eth2)
#   ✔ are trimmed automatically
#
# 