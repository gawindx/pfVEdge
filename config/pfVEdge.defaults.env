# VM resources (overridable)
DISK_SIZE="10G"
RAM_SIZE="4G"
CPU_CORES="1"

# By default, pfVEdge will download pfSense img but you can override this 
PF_BOOT="pfsense"

# give 60 seconds for pfVEdge vm to gracefully stop
TIMEOUT=60

# Watchdog defaults value
WDG_CHECK_INTERVAL=30
WDG_START_DELAY=120
WDG_MAX_FAIL=3
WDG_SHUTDOWN_TIMEOUT=60

# You can use this as alternative in case of problem
# QEMU_NET_MODEL=e1000
QEMU_NET_MODEL=virtio-net-pci

# In case of more than 1 vCPU, you can use multiqueue for network (virtio-net-pci only) 
QEMU_VIRTIO_NET_MQ=true

# Override if you cannot use KVM
# KVM=N
